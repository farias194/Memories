{% assign a_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .alt-hero-{{ a_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 500px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .alt-hero-media-{{ a_id }} {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-image: url('{{ section.settings.image | image_url: width: 1600 }}');
    transform: scale(1.05);
    animation: altHeroSubtleZoom-{{ a_id }} 20s ease-in-out infinite alternate;
  }

  .alt-hero-overlay-{{ a_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at center,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.4) 45%,
      rgba(0, 0, 0, 0.85) 75%,
      rgba(0, 0, 0, 0.98) 100%
    );
    background-size: 100% 100%;
    background-position: center;
    animation: altHeroPulse-{{ a_id }} 8s ease-in-out infinite;
  }

  .alt-hero-content-{{ a_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 2rem;
    max-width: 700px;
  }

  .alt-hero-title-{{ a_id }} {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    margin: 0 0 1rem 0;
    opacity: 0;
    animation: altHeroFadeUp-{{ a_id }} 1.2s ease-out 0.3s forwards;
    text-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  .alt-hero-subtitle-{{ a_id }} {
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    opacity: 0;
    animation: altHeroFadeUp-{{ a_id }} 1.2s ease-out 0.6s forwards;
    text-shadow: 0 1px 10px rgba(0,0,0,0.3);
  }

  @keyframes altHeroSubtleZoom-{{ a_id }} {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.15); }
  }

  @keyframes altHeroPulse-{{ a_id }} {
    0% {
      background-size: 100% 100%;
      opacity: 0.9;
    }
    50% {
      background-size: 140% 140%;
      opacity: 1;
    }
    100% {
      background-size: 100% 100%;
      opacity: 0.9;
    }
  }

  @keyframes altHeroFadeUp-{{ a_id }} {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstyle %}

<div class="alt-hero-{{ a_id }}">
  <div class="alt-hero-media-{{ a_id }}" aria-hidden="true"></div>
  <div class="alt-hero-overlay-{{ a_id }}" aria-hidden="true"></div>
  <div class="alt-hero-content-{{ a_id }}">
    {% if section.settings.title != blank %}
      <h1 class="alt-hero-title-{{ a_id }}">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="alt-hero-subtitle-{{ a_id }}">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Alternate Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Breathe In"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A subtle pulse that draws the eye to center"
    }
  ],
  "presets": [
    {
      "name": "Alternate Hero",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
