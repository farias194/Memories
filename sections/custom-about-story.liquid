{% comment %}
Custom About Story section
Displays brand story milestones as a vertical timeline: a single centered
column of event cards with a line running down the middle behind the cards.
A dot sits centered on the line above each card and flips to the active line
color as the scroll-driven progress fill crosses it. Fully self-contained:
styles and scripts are scoped to this section.
{% endcomment %}

{% assign a_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .about-story-section-{{ a_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-right: {{ section.settings.padding_right }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-right: {{ section.settings.margin_right }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    margin-left: {{ section.settings.margin_left }}px;
  }

  .about-story-{{ a_id }} {
    position: relative;
    max-width: {{ section.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .about-story-list-{{ a_id }} {
    position: relative;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  /* Line behind the events, centered */
  .about-story-line-{{ a_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: {{ section.settings.line_width }}px;
    transform: translateX(-50%);
    background-color: {{ section.settings.line_color }};
    overflow: hidden;
    z-index: 1;
  }

  .about-story-progress-{{ a_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background-color: {{ section.settings.line_active_color }};
  }

  .about-story-item-{{ a_id }} {
    position: relative;
    padding-top: 28px;
    padding-bottom: {{ section.settings.item_gap }}px;
    text-align: center;
    z-index: 2;
  }

  .about-story-item-{{ a_id }}:last-child {
    padding-bottom: 0;
  }

  /* Dots centred on the line, straddling it */
  .about-story-dot-{{ a_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color }};
    border: {{ section.settings.dot_border_width }}px solid {{ section.settings.dot_border_color }};
    transition: background-color 0.3s ease, border-color 0.3s ease;
    z-index: 3;
  }

  .about-story-item-{{ a_id }}.active .about-story-dot-{{ a_id }} {
    background-color: {{ section.settings.line_active_color }};
    border-color: {{ section.settings.line_active_color }};
  }

  .about-story-card-{{ a_id }} {
    background-color: {{ section.settings.content_bg_color }};
    padding: {{ section.settings.content_padding }}px;
    border-radius: {{ section.settings.content_border_radius }}px;
    text-align: left;
  }

  .about-story-image-{{ a_id }} {
    margin-bottom: 14px;
    border-radius: {{ section.settings.content_border_radius }}px;
    overflow: hidden;
  }

  .about-story-image-{{ a_id }} img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .about-story-title-{{ a_id }} {
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .about-story-text-{{ a_id }} {
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .about-story-{{ a_id }} {
      max-width: 100%;
    }

    .about-story-list-{{ a_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="about-story-section-{{ a_id }}">
  <div class="about-story-{{ a_id }}">
    <div class="about-story-line-{{ a_id }}" data-about-line>
      <div class="about-story-progress-{{ a_id }}" data-about-progress></div>
    </div>

    <div class="about-story-list-{{ a_id }}" data-about-list>
      {% for block in section.blocks %}
        <div class="about-story-item-{{ a_id }}" data-about-item {{ block.shopify_attributes }}>
          <div class="about-story-dot-{{ a_id }}"></div>

          <div class="about-story-card-{{ a_id }}">
            {% if block.settings.image != blank %}
              <div class="about-story-image-{{ a_id }}">
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.title | escape | default: 'Story image' }}"
                  loading="lazy"
                  width="600"
                  height="338"
                >
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3
                class="about-story-title-{{ a_id }}"
                style="color: {{ block.settings.title_color }}; font-size: {{ block.settings.title_font_size }}px; font-weight: {{ block.settings.title_font_weight }};"
              >{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div
                class="about-story-text-{{ a_id }}"
                style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_font_size }}px;"
              >{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.about-story-{{ a_id }}');
    if (!root) return;

    var list = root.querySelector('[data-about-list]');
    var line = root.querySelector('[data-about-line]');
    var progress = root.querySelector('[data-about-progress]');
    if (!list || !line || !progress) return;

    var items = Array.prototype.slice.call(list.querySelectorAll('[data-about-item]'));

    function update() {
      var winH = window.innerHeight;
      var trigger = winH * 0.75;
      var listRect = list.getBoundingClientRect();
      var listH = listRect.height || 1;
      var maxProgress = 0;

      items.forEach(function (item) {
        var rect = item.getBoundingClientRect();
        var mid = rect.top + rect.height / 2;

        if (mid < trigger) {
          item.classList.add('active');

          var relMid = rect.top - listRect.top + rect.height / 2;
          var p = (relMid / listH) * 100;
          if (p > maxProgress) maxProgress = p;
        } else {
          item.classList.remove('active');
        }
      });

      progress.style.height = Math.min(maxProgress, 100) + '%';
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

