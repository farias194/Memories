{% capture children %}{% content_for 'blocks' %}{% endcapture %}

<div
  id="HeroFade-{{ section.id }}"
  class="hero-fade-custom section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% if section.settings.section_height == 'custom' %}--section-min-height: {{ section.settings.section_height_custom }}svh;{% endif %} {% render 'spacing-style', settings: section.settings %} {% if section.settings['margin-block-start'] != blank %}--margin-block-start: {{ section.settings['margin-block-start'] }}px;{% endif %} {% if section.settings['margin-block-end'] != blank %}--margin-block-end: {{ section.settings['margin-block-end'] }}px;{% endif %} {% if section.settings['margin-inline-start'] != blank %}--margin-inline-start: {{ section.settings['margin-inline-start'] }}px;{% endif %} {% if section.settings['margin-inline-end'] != blank %}--margin-inline-end: {{ section.settings['margin-inline-end'] }}px;{% endif %}"
>
  <div class="hero-fade-custom__background">
    {% comment %} Compute mask position based on setting and prepare mask image or gradient via CSS variables on the wrapper {% endcomment %}
    {% case section.settings.radial_position %}
      {% when 'top left' %}
        {% assign rx = '0%' %}{% assign ry = '0%' %}
      {% when 'top right' %}
        {% assign rx = '100%' %}{% assign ry = '0%' %}
      {% when 'bottom left' %}
        {% assign rx = '0%' %}{% assign ry = '100%' %}
      {% when 'bottom right' %}
        {% assign rx = '100%' %}{% assign ry = '100%' %}
      {% when 'center' %}
        {% assign rx = '50%' %}{% assign ry = '50%' %}
      {% else %}
        {% assign rx = '50%' %}{% assign ry = '50%' %}
    {% endcase %}

    {% if section.settings.enable_radial_overlay %}
      <div class="hero-fade-custom__media-wrapper" style="--mask-pos-x: {{ rx }}; --mask-pos-y: {{ ry }}; --mask-duration: {{ section.settings.radial_duration }}s; --mask-size-min: {{ section.settings.radial_scale_min }}%; --mask-size-max: {{ section.settings.radial_scale_max }}%; --mask-strength: {{ section.settings.radial_strength | divided_by: 100.0 }}; {% if section.settings.mask_image != blank %}--mask-image: url('{{ section.settings.mask_image | img_url: 'master' }}');{% else %}--mask-image: radial-gradient(circle at {{ rx }} {{ ry }}, rgba(0,0,0,0) 40%, rgba(0,0,0,{{ section.settings.radial_strength | divided_by: 100.0 }}) 100%);{% endif %}">
    {% else %}
      <div class="hero-fade-custom__media-wrapper">
    {% endif %}
      {% if section.settings.image != blank %}
        {% render 'image', image: section.settings.image, class: 'hero-fade-custom__media border-style' %}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-fade-custom__media' }}
      {% endif %}
    </div>
  </div>
  <div class="hero-fade-custom__overlay"></div>

  <div class="hero-fade-custom__content spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {{ children }}
  </div>
</div>

{% stylesheet %}
  .hero-fade-custom {
    position: relative;
    overflow: hidden;
    --fade-overlay-color: rgba(0,0,0,0.32);
  }

  .hero-fade-custom__background {
    position: relative;
    z-index: var(--layer-0);
    will-change: transform, opacity;
    overflow: hidden;
  }

  .hero-fade-custom__media-wrapper {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .hero-fade-custom__background img.hero-fade-custom__media {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  /* Apply a mask (uploaded image or radial gradient) to the image itself via CSS variables on the wrapper */
  .hero-fade-custom__media-wrapper img.hero-fade-custom__media,
  .hero-fade-custom__media-wrapper .hero-fade-custom__media {
    -webkit-mask-image: var(--mask-image);
    mask-image: var(--mask-image);
    -webkit-mask-position: var(--mask-pos-x, 50%) var(--mask-pos-y, 50%);
    mask-position: var(--mask-pos-x, 50%) var(--mask-pos-y, 50%);
    -webkit-mask-size: var(--mask-size-min, 80%);
    mask-size: var(--mask-size-min, 80%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: radial-pulse var(--mask-duration, 12s) ease-in-out infinite;
  }

  @keyframes radial-pulse {
    0% { -webkit-mask-size: var(--mask-size-min, 80%); mask-size: var(--mask-size-min, 80%); opacity: 1; }
    50% { -webkit-mask-size: var(--mask-size-max, 120%); mask-size: var(--mask-size-max, 120%); opacity: 0.6; }
    100% { -webkit-mask-size: var(--mask-size-min, 80%); mask-size: var(--mask-size-min, 80%); opacity: 1; }
  }

  .hero-fade-custom__overlay {
    position: absolute;
    inset: 0;
    z-index: var(--layer-1);
    pointer-events: none;
    /* subtle top-to-bottom fade to transparent */
    background: linear-gradient(to bottom, var(--fade-overlay-color), transparent 45%);
  }

  .hero-fade-custom__content {
    position: relative;
    z-index: var(--layer-flat);
    display: flex;
    align-items: center;
    justify-content: center;
    /* allow content to overlay the media */
    margin-top: calc(-1 * var(--padding-block-start, 0px));
  }

  /* Ensure inner block content is vertically stacked and readable */
  .hero-fade-custom__content > .group-block-content {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 12px);
    max-width: 1200px;
    width: 100%;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Custom Hero Fade",
  "class": "hero-fade-custom-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Top",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Bottom",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-inline-start",
      "label": "Left",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-inline-end",
      "label": "Right",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_radial_overlay",
      "label": "Enable radial animated overlay",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mask_image",
      "label": "Mask image (optional)"
    },
    {
      "type": "select",
      "id": "radial_position",
      "label": "Radial origin",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top right", "label": "Top right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom right", "label": "Bottom right" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },

    {
      "type": "range",
      "id": "radial_strength",
      "label": "Corner fade strength",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 95
    },
    {
      "type": "range",
      "id": "radial_duration",
      "label": "Animation duration (seconds)",
      "min": 2,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 12
    },
    {
      "type": "range",
      "id": "radial_scale_min",
      "label": "Animation scale (min)",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "radial_scale_max",
      "label": "Animation scale (max)",
      "min": 100,
      "max": 200,
      "step": 1,
      "unit": "%",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text"
    },
    {
      "type": "button",
      "name": "Button"
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero Fade Custom",
      "category": "Hero",
      "blocks": [
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}