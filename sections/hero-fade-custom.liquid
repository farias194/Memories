{% capture children %}{% content_for 'blocks' %}{% endcapture %}

<div
  id="HeroFade-{{ section.id }}"
  class="hero-fade-custom section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% if section.settings.section_height == 'custom' %}--section-min-height: {{ section.settings.section_height_custom }}svh;{% endif %} {% render 'spacing-style', settings: section.settings %} {% if section.settings['margin-block-start'] != blank %}--margin-block-start: {{ section.settings['margin-block-start'] }}px;{% endif %} {% if section.settings['margin-block-end'] != blank %}--margin-block-end: {{ section.settings['margin-block-end'] }}px;{% endif %} {% if section.settings['margin-inline-start'] != blank %}--margin-inline-start: {{ section.settings['margin-inline-start'] }}px;{% endif %} {% if section.settings['margin-inline-end'] != blank %}--margin-inline-end: {{ section.settings['margin-inline-end'] }}px;{% endif %}"
>
  <div class="hero-fade-custom__background">
    <div class="hero-fade-custom__media-wrapper">
      {% if section.settings.image != blank %}
        {% render 'image', image: section.settings.image, class: 'hero-fade-custom__media border-style' %}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-fade-custom__media' }}
      {% endif %}
      {% if section.settings.enable_radial_overlay %}
        <div class="hero-fade-custom__radial" style="--radial-pos: {{ section.settings.radial_position }}; --radial-strength: {{ section.settings.radial_strength | divided_by: 100.0 }}; --radial-duration: {{ section.settings.radial_duration }}s; --radial-scale-min: {{ section.settings.radial_scale_min }}; --radial-scale-max: {{ section.settings.radial_scale_max }};"></div>
      {% endif %}
    </div>
  </div>
  <div class="hero-fade-custom__overlay"></div>

  <div class="hero-fade-custom__content spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {{ children }}
  </div>
</div>

{% stylesheet %}
  .hero-fade-custom {
    position: relative;
    overflow: hidden;
    --fade-overlay-color: rgba(0,0,0,0.32);
  }

  .hero-fade-custom__background {
    position: relative;
    z-index: var(--layer-0);
    will-change: transform, opacity;
    overflow: hidden;
  }

  .hero-fade-custom__media-wrapper {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .hero-fade-custom__background img.hero-fade-custom__media {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  .hero-fade-custom__media-wrapper .hero-fade-custom__radial {
    position: absolute;
    inset: 0;
    z-index: 2; /* above the image within the wrapper */
    pointer-events: none;
    mix-blend-mode: normal;
    /* use the radial position directly for transform-origin */
    transform-origin: var(--radial-pos, top left);
    animation: radial-pulse var(--radial-duration, 12s) ease-in-out infinite;
    background: radial-gradient(circle at var(--radial-pos, top left), rgba(0,0,0,0) 40%, rgba(0,0,0,var(--radial-strength, 0.95)) 100%);
    transform: scale(calc(var(--radial-scale-min, 80) / 100));
  }

  @keyframes radial-pulse {
    0% { transform: scale(calc(var(--radial-scale-min, 80) / 100)); opacity: 1; }
    50% { transform: scale(calc(var(--radial-scale-max, 120) / 100)); opacity: 0.6; }
    100% { transform: scale(calc(var(--radial-scale-min, 80) / 100)); opacity: 1; }
  }

  .hero-fade-custom__overlay {
    position: absolute;
    inset: 0;
    z-index: var(--layer-1);
    pointer-events: none;
    /* subtle top-to-bottom fade to transparent */
    background: linear-gradient(to bottom, var(--fade-overlay-color), transparent 45%);
  }

  .hero-fade-custom__content {
    position: relative;
    z-index: var(--layer-flat);
    display: flex;
    align-items: center;
    justify-content: center;
    /* allow content to overlay the media */
    margin-top: calc(-1 * var(--padding-block-start, 0px));
  }

  /* Ensure inner block content is vertically stacked and readable */
  .hero-fade-custom__content > .group-block-content {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 12px);
    max-width: 1200px;
    width: 100%;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Custom Hero Fade",
  "class": "hero-fade-custom-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Top",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Bottom",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-inline-start",
      "label": "Left",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin-inline-end",
      "label": "Right",
      "min": 1,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_radial_overlay",
      "label": "Enable radial animated overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "radial_position",
      "label": "Radial origin",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top right", "label": "Top right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "default": "top left"
    },
    {
      "type": "range",
      "id": "radial_strength",
      "label": "Corner fade strength",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 95
    },
    {
      "type": "range",
      "id": "radial_duration",
      "label": "Animation duration (seconds)",
      "min": 2,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 12
    },
    {
      "type": "range",
      "id": "radial_scale_min",
      "label": "Animation scale (min)",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "radial_scale_max",
      "label": "Animation scale (max)",
      "min": 100,
      "max": 200,
      "step": 1,
      "unit": "%",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text"
    },
    {
      "type": "button",
      "name": "Button"
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero Fade Custom",
      "category": "Hero",
      "blocks": [
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}