          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Review",
          "default": "<p>This shop is amazing! The perfect souvenir, and the staff was so helpful.</p>"
        },
        {
          "type": "select",
          "id": "quote_type_preset",
          "label": "Review text style",
          "options": [
            {
              "value": "paragraph",
              "label": "Paragraph"
            },
            {
              "value": "h4",
              "label": "Heading 4"
            },
            {
              "value": "h5",
              "label": "Heading 5"
            },
            {
              "value": "h6",
              "label": "Heading 6"
            }
          ],
          "default": "paragraph",
          "info": "Uses your theme's typography settings"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "info": "e.g. Google, Yelp, Trustpilot"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "category": "t:categories.storytelling",
      "blocks": [
        {
