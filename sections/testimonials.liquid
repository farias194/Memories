{% comment %}
Testimonials section
Displays customer reviews either as a grid or an auto-advancing carousel.
Fully self-contained: styles and scripts are scoped to this section only.
{% endcomment %}

{% assign t_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .testimonials-{{ t_id }} {
    --testimonial-bg: {{ section.settings.card_background_color }};
    --testimonial-bg-alt: {{ section.settings.card_alternate_background_color }};
    --testimonial-text: {{ section.settings.card_text_color }};
    --testimonial-star: {{ section.settings.star_color }};
    padding: 48px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonials-{{ t_id }}__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .testimonials-{{ t_id }}__heading {
    margin: 0 0 8px;
  }

  .testimonials-{{ t_id }}__description {
    margin: 0;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    color: {{ section.settings.card_text_color }};
    opacity: 0.75;
  }

  .testimonials-{{ t_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  .testimonials-{{ t_id }}__carousel {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 8px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonials-{{ t_id }}__carousel::-webkit-scrollbar {
    display: none;
  }

  .testimonials-{{ t_id }}__card {
    background-color: var(--testimonial-bg);
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-snap-align: start;
    flex: 0 0 {{ section.settings.card_width }}%;
  }

  {% if section.settings.alternating_colors %}
    .testimonials-{{ t_id }}__card:nth-child(even) {
      background-color: var(--testimonial-bg-alt);
    }
  {% endif %}

  .testimonials-{{ t_id }}__card[hidden] {
    display: none;
  }

  .testimonials-{{ t_id }}__stars {
    display: flex;
    gap: 2px;
  }

  .testimonials-{{ t_id }}__star {
    width: 18px;
    height: 18px;
    color: var(--testimonial-star);
  }

  .testimonials-{{ t_id }}__quote {
    margin: 0;
    --color: var(--testimonial-text);
    flex: 1 1 auto;
  }

  .testimonials-{{ t_id }}__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonials-{{ t_id }}__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 44px;
    background: rgba(0,0,0,0.05);
  }

  .testimonials-{{ t_id }}__author {
    font-weight: 700;
    font-size: 15px;
    color: var(--testimonial-text);
  }

  .testimonials-{{ t_id }}__source {
    font-size: 13px;
    color: var(--testimonial-text);
    opacity: 0.6;
  }

  .testimonials-{{ t_id }}__controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .testimonials-{{ t_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    color: {{ section.settings.card_text_color }};
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .testimonials-{{ t_id }}__button:hover {
    opacity: 0.7;
  }

  .testimonials-{{ t_id }}__button svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 749px) {
    .testimonials-{{ t_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="testimonials-{{ t_id }}" data-testimonials="{{ t_id }}">
  <div class="testimonials-{{ t_id }}__header">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials-{{ t_id }}__heading {{ section.settings.heading_type_preset | default: 'h3' }}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="testimonials-{{ t_id }}__description {{ section.settings.description_type_preset | default: 'paragraph' }}">{{ section.settings.description }}</div>
    {% endif %}
  </div>

  <div
    class="testimonials-{{ t_id }}__{% if section.settings.layout == 'carousel' %}carousel{% else %}grid{% endif %}"
    data-testimonials-track
    {% if section.settings.layout == 'carousel' %}
      role="region"
      aria-label="{{ section.settings.heading | default: 'Testimonials' }}"
    {% endif %}
  >
    {% for block in section.blocks %}
      <div class="testimonials-{{ t_id }}__card" {{ block.shopify_attributes }}>
        <div class="testimonials-{{ t_id }}__stars" aria-label="{{ block.settings.rating }} out of 5 stars" role="img">
          {% for i in (1..5) %}
            <svg class="testimonials-{{ t_id }}__star" viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" {% if i > block.settings.rating %}style="opacity:0.25"{% endif %}>
              {% render 'icon', icon: 'star' %}
            </svg>
          {% endfor %}
        </div>

        {% if block.settings.quote != blank %}
          <div class="testimonials-{{ t_id }}__quote {{ block.settings.quote_type_preset | default: 'paragraph' }}">{{ block.settings.quote }}</div>
        {% endif %}

        <div class="testimonials-{{ t_id }}__meta">
          {% if block.settings.image != blank %}
            <img
              class="testimonials-{{ t_id }}__avatar"
              src="{{ block.settings.image | image_url: width: 200 }}"
              alt="{{ block.settings.author | escape }}"
              loading="lazy"
              width="44"
              height="44"
            >
          {% endif %}
          <div>
            {% if block.settings.author != blank %}
              <div class="testimonials-{{ t_id }}__author">{{ block.settings.author }}</div>
            {% endif %}
            {% if block.settings.source != blank %}
              <div class="testimonials-{{ t_id }}__source">{{ block.settings.source }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.layout == 'carousel' %}
    <div class="testimonials-{{ t_id }}__controls" data-testimonials-controls>
      <button
        type="button"
        class="testimonials-{{ t_id }}__button"
        data-testimonials-prev
        aria-label="Previous testimonial"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
          {% render 'icon', icon: 'caret' %}
        </svg>
      </button>
      <button
        type="button"
        class="testimonials-{{ t_id }}__button"
        data-testimonials-next
        aria-label="Next testimonial"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(180deg)">
          {% render 'icon', icon: 'caret' %}
        </svg>
      </button>
    </div>
  {% endif %}
</div>

{% if section.settings.layout == 'carousel' %}
<script>
  (function () {
    var id = '{{ t_id }}';
    var root = document.querySelector('[data-testimonials="' + id + '"]');
    if (!root) return;

    var track = root.querySelector('[data-testimonials-track]');
    var prevBtn = root.querySelector('[data-testimonials-prev]');
    var nextBtn = root.querySelector('[data-testimonials-next]');
    if (!track) return;

    function cardStep() {
      var card = track.querySelector('.testimonials-' + id + '__card');
      if (!card) return 1;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 24;
      return card.getBoundingClientRect().width + gap;
    }

    function scrollByStep(dir) {
      var step = cardStep() * dir;
      track.scrollBy({ left: step, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByStep(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByStep(1); });

    var autoplay = {{ section.settings.autoplay_enable | json }};
    var interval = {{ section.settings.autoplay_speed | json }};
    var timer = null;

    function startAutoplay() {
      if (!autoplay || interval <= 0) return;
      timer = setInterval(function () { scrollByStep(1); }, interval * 1000);
    }

    function stopAutoplay() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('focusin', stopAutoplay);
    track.addEventListener('focusout', startAutoplay);

    startAutoplay();
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Read why customers love shopping with us.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (grid only)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Cards visible (carousel only)",
      "min": 33,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 33,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Carousel behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enable",
      "label": "Enable autoplay",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay interval",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay_enable }}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#F5F5F5"
    },
    {
      "type": "checkbox",
      "id": "alternating_colors",
      "label": "Alternating colors",
      "info": "Cards alternate between the card background color and the alternate card background color below.",
      "default": false
    },
    {
      "type": "color",
      "id": "card_alternate_background_color",
      "label": "Alternate card background",
      "default": "#E8E8E8",
      "visible_if": "{{ section.settings.alternating_colors }}"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F5A623"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border thickness",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E0E0E0"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading style",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        },
        {
          "value": "h5",
          "label": "Heading 5"
        },
        {
          "value": "h6",
          "label": "Heading 6"
        },
        {
          "value": "paragraph",
          "label": "Paragraph"
        }
      ],
      "default": "h3",
      "info": "Uses your theme's typography settings"
    },
    {
      "type": "select",
      "id": "description_type_preset",
      "label": "Description style",
      "options": [
        {
          "value": "paragraph",
          "label": "Paragraph"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        },
        {
          "value": "h5",
          "label": "Heading 5"
        },
        {
          "value": "h6",
          "label": "Heading 6"
        }
      ],
      "default": "paragraph",
      "info": "Uses your theme's typography settings"
    }
  ],
  "blocks": [
    {
