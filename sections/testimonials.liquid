          "type": "review",
          "settings": {
            "rating": 4,
            "author": "Sam Patel",
            "source": "Trustpilot",
            "quote": "<p>Great quality t-shirts and the prices are fair. Will be back!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
