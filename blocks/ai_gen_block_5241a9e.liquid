{% doc %}
  @prompt
    Add a fade-in animation effect to a text block. When the text comes into view on the page, it should smoothly fade in from transparent to fully visible. The animation should trigger on page load or when the element scrolls into view.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fade-in-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    opacity: 0;
    transform: translateY({{ block.settings.translate_distance }}px);
    transition: opacity {{ block.settings.animation_duration }}s ease-out, transform {{ block.settings.animation_duration }}s ease-out;
  }

  .ai-fade-in-text-{{ ai_gen_id }}.ai-fade-in-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-fade-in-text__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing_between }}px 0;
  }

  .ai-fade-in-text__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-fade-in-text__content-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-fade-in-text-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-fade-in-text__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-fade-in-text__content-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<fade-in-text-{{ ai_gen_id }}
  class="ai-fade-in-text-{{ ai_gen_id }}"
  data-threshold="{{ block.settings.trigger_threshold }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-fade-in-text__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.text != blank %}
    <div class="ai-fade-in-text__content-{{ ai_gen_id }}">
      {{ block.settings.text }}
    </div>
  {% endif %}
</fade-in-text-{{ ai_gen_id }}>

<script>
  (function() {
    class FadeInText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.observer = null;
      }

      connectedCallback() {
        const threshold = parseFloat(this.dataset.threshold) || 0.2;

        this.observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                this.classList.add('ai-fade-in-visible-{{ ai_gen_id }}');
                this.observer.unobserve(this);
              }
            });
          },
          {
            threshold: threshold,
            rootMargin: '0px'
          }
        );

        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('fade-in-text-{{ ai_gen_id }}', FadeInText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Fade-in text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
