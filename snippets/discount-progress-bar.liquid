{% comment %}
  ==================================================
  DISCOUNT PROGRESS BAR
  ==================================================
  Reads one metaobject entry per discount threshold
  (type: discount_threshold) and renders a progress
  bar if the cart qualifies.
{% endcomment %}

{%- assign cart_subtotal_cents = cart.items_subtotal_price -%}

{%- comment -%}
  metaobjects['discount_threshold'] supports KEYED access but NOT iteration
  ({% for %} over it yields nothing) in this Liquid era — so iterate a fixed
  handle range instead. The app writes handles discount-1..N (sorted by
  threshold, ascending).
{%- endcomment -%}

{%- assign next_threshold = nil -%}
{%- for i in (1..10) -%}
  {%- assign t = metaobjects['discount_threshold']['discount-' | append: i] -%}
  {%- if t == blank -%}{%- continue -%}{%- endif -%}
  {%- assign is_enabled = t.enabled.value -%}
  {%- assign threshold_cents = t.threshold_minor.value | plus: 0 -%}
  {%- if is_enabled != false and is_enabled != 'false' and threshold_cents > cart_subtotal_cents -%}
    {%- if next_threshold == nil -%}
      {%- assign next_threshold = t -%}
    {%- else -%}
      {%- assign nt_cents = next_threshold.threshold_minor.value | plus: 0 -%}
      {%- if threshold_cents < nt_cents -%}
        {%- assign next_threshold = t -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if next_threshold != nil -%}
    {%- comment -%} Calculate progress percentage {%- endcomment -%}
    {%- assign progress_cents = cart_subtotal_cents -%}
    {%- assign target_cents = next_threshold.threshold_minor.value | plus: 0 -%}
    {%- assign percentage = progress_cents | times: 100 | divided_by: target_cents -%}
    {%- if percentage > 100 -%}{%- assign percentage = 100 -%}{%- endif -%}

    {%- comment -%} Remaining amount (cents) to reach the next threshold {%- endcomment -%}
    {%- assign remaining_cents = target_cents | minus: progress_cents -%}

    <div class="discount-progress-bar" style="margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-radius: 8px;">
      <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px;">
        <span>
          🛒 Spend <strong>{{ remaining_cents | money }}</strong> more to unlock <strong>{{ next_threshold.label.value }}</strong>
        </span>
        <span>{{ percentage | round: 0 }}%</span>
      </div>
      <div style="width: 100%; height: 8px; background: #e0e0e0; border-radius: 4px; overflow: hidden;">
        <div style="width: {{ percentage }}%; height: 100%; background: #2e7d32; transition: width 0.3s ease;"></div>
      </div>
      <p style="margin: 8px 0 0 0; font-size: 12px; color: #666;">
        {{ next_threshold.title.value }} – Add items to your cart to qualify.
      </p>
    </div>
  {%- else -%}
    <div class="discount-progress-bar" style="margin: 1rem 0; padding: 1rem; background: #e8f5e9; border-radius: 8px;">
      🎉 You've unlocked all available discounts!
    </div>
  {%- endif -%}
